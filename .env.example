# Copiar a .env (no se sube a git)
MISECRE_TELEGRAM_TOKEN=
# ANTHROPIC_API_KEY=            # opcional: fallback de IA (ai.enabled: true)
# GROQ_API_KEY=                 # opcional: voz en la nube (stt.provider: groq)
# OPENAI_API_KEY=               # opcional: voz en la nube (stt.provider: openai)

# Solo en una PC que usa el listener de avisos contra un servidor remoto (va en ~/.misecre/.env):
# MISECRE_SERVER=https://misecre.tudominio.com
# MISECRE_TOKEN=msc_...
